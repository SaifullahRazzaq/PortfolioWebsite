# Copy to .env.local for local testing. In production these are set in
# Netlify → Site configuration → Environment variables.

# GA4 Measurement ID (Google Analytics → Admin → Data streams → Web).
# Leave empty to turn analytics off.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: canonical site address once a custom domain is live.
# Without it, Netlify's own site URL is used.
NEXT_PUBLIC_SITE_URL=
